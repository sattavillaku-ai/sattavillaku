# Sattavilakku (சட்டவிளக்கு) - Production Environment Variables Example
# Copy this file to .env.local for development or configure in your deployment platform (e.g. Vercel).
# NEVER commit real secret keys or credentials to version control.

# 1. Supabase Public Client Credentials (Required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. Supabase Service Role Key (Optional / Server-Only)
SUPABASE_SERVICE_ROLE_KEY=

# 3. Cloudinary Media Storage (Server-Only, for Admin Media Library)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Google Gemini AI (Server-Only, for News Draft Generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 5. Scheduled News Collector Cron Security (Server-Only)
NEWS_COLLECTOR_SECRET=
CRON_SECRET=

# 6. Canonical Site URL (Used for SEO, sitemaps, OpenGraph, and OAuth callbacks)
NEXT_PUBLIC_SITE_URL=https://sattavilakku.com
