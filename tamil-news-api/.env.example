# ==========================================
# Tamil News Aggregation API - Environment Configuration
# ==========================================

# 1. Supabase PostgreSQL Credentials (Required)
# Found in Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 2. News Collection Scheduler
# Interval in minutes between automated Google News RSS fetches
NEWS_FETCH_INTERVAL_MINUTES=10

# 3. Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# 4. CORS Origins (comma-separated or * for development)
# Allow frontend React / Next.js app to consume the API
CORS_ORIGINS=*
